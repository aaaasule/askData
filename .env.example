# Copy to .env and adjust. Do not commit .env.
API_KEY=change-me

# Local default. The app database (datasources / models registry), not the
# business database you query.
DATABASE_URL=sqlite+aiosqlite:///./askdata.db

# Postgres / MySQL are the same setting once drivers are installed
# (`pip install -e ".[db]"`). Alembic uses the async URL directly.
# DATABASE_URL=postgresql+asyncpg://askdata:askdata@localhost:5432/askdata
# DATABASE_URL=mysql+aiomysql://askdata:askdata@localhost:3306/askdata

# Used when chat/stream omits modelId and no enabled aigc_model row exists.
# base_url is the OpenAI-compatible prefix, usually ending in /v1.
DEFAULT_MODEL_BASE_URL=
DEFAULT_MODEL_API_KEY=
DEFAULT_MODEL_NAME=

CORS_ORIGINS=*
SQL_MAX_ROWS=200
SQL_TIMEOUT_SECONDS=30
ANALYSIS_TIMEOUT_SECONDS=120

# Encrypts datasource passwords and model api keys at rest (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRET_ENCRYPTION_KEY is an alias. If both are empty, the key is derived from API_KEY
# so a local demo keeps working. Rotating the key cannot read old ciphertext; re-save
# each secret (legacy plaintext rows are encrypted the next time they are read).
ASKDATA_SECRET_KEY=

# How much prior analysis history is replayed for the same conversationId.
CONVERSATION_MAX_MESSAGES=12
CONVERSATION_MAX_CHARS=12000
